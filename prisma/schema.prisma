generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  nip           String   @unique
  nama          String
  email         String   @unique
  password      String
  role          String   @default("PEGAWAI") // ADMIN | PEGAWAI
  photo         String?
  faceDescriptor String?  // JSON string of face embedding vector
  faceRegisteredAt DateTime? // When face was registered
  unitKerja     String?
  jabatan       String?
  unitKerjaId   String?
  jabatanId     String?
  shiftId       String?   // Assigned work shift
  mulaiBekerja  DateTime? // Start working date
  tanggalSelesai DateTime? // End working date (null = still active)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  shift         WorkShift? @relation(fields: [shiftId], references: [id])
  unitKerjaRef  UnitKerja? @relation(fields: [unitKerjaId], references: [id])
  jabatanRef    Jabatan? @relation(fields: [jabatanId], references: [id])
}

model UnitKerja {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model Jabatan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model Attendance {
  id          String   @id @default(cuid())
  userId      String
  type        String   // MASUK | PULANG
  latitude    Float    @default(0)
  longitude   Float    @default(0)
  photo       String?
  confidence  Float    @default(0)
  status      String   @default("HADIR") // HADIR | TELAT | IZIN | CUTI | ALPHA | DINAS | PULANG_CEPAT
  note        String?
  shiftId     String?  // Which shift this attendance belongs to
  isManual    Boolean  @default(false) // true if created manually by admin
  manualBy    String?  // admin user ID who created it
  buktiDukung String?  // Supporting document photo (base64 compressed) for admin edit/manual
  editedBy    String?  // admin user ID who last edited
  editedAt    DateTime? // when last edited
  editReason  String?  // reason for the edit
  isDeleted   Boolean  @default(false) // soft delete flag
  deletedBy   String?  // admin user ID who deleted
  deletedAt   DateTime? // when deleted
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift       WorkShift? @relation(fields: [shiftId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([isDeleted])
}

model Office {
  id          String   @id @default(cuid())
  name        String
  address     String?
  latitude    Float
  longitude   Float
  radiusMeter Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkShift {
  id          String   @id @default(cuid())
  name        String   // e.g. "Reguler", "Security", "Jaga Malam", "Driver", "CS"
  startTime   String   // "08:00"
  endTime     String   // "17:00"
  lateTolerance Int    @default(15) // minutes
  workDays    String   @default("1,2,3,4,5") // 0=Minggu, 1=Senin, etc.
  color       String   @default("#1e40af") // Display color for this shift
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  attendances Attendance[]
}

model OfficeSetting {
  id          String   @id @default(cuid())
  officeName  String   @default("Kantor Pusat")
  latitude    Float    @default(-6.2088)
  longitude   Float    @default(106.8456)
  radiusMeter Int      @default(100)
  startTime   String   @default("08:00")
  endTime     String   @default("17:00")
  lateTolerance Int    @default(15)
  workDays    String   @default("1,2,3,4,5")
  appName       String   @default("Sistem Absensi Pegawai")
  logoPath      String?
  faviconPath   String?
  pwaIcon192Path String?
  pwaIcon512Path String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  type        String   @default("NASIONAL") // NASIONAL | KEAGAMAAN | KHUSUS
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
}

model LeaveRequest {
  id          String   @id @default(cuid())
  userId      String
  type        String   // IZIN | CUTI | SAKIT | DINAS or custom code from LeaveTypeCategory
  startDate   DateTime
  endDate     DateTime
  reason      String
  attachment  String?  // File path for bukti dukung (supporting document)
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?
  approvedAt  DateTime?
  isManualEntry Boolean @default(false) // true if created by admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model LeaveTypeCategory {
  id          String   @id @default(cuid())
  name        String   // Display name e.g. "Cuti Tahunan", "Izin Pribadi", "Dinas Luar"
  code        String   @unique // Unique code e.g. "CUTI_TAHUNAN", "IZIN_PRIBADI", "DINAS_LUAR"
  description String?  // Optional description
  color       String   @default("#1e40af") // Display color
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   // The user who receives the notification
  type        String   // leave | late | info | attendance
  title       String
  message     String
  isRead      Boolean  @default(false)
  relatedId   String?  // Optional reference to related entity (leave request ID, etc.)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
